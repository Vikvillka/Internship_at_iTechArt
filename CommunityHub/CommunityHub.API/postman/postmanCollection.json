				{
					"listen": "test",
					"script": {
						"exec": [
							"let json = pm.response.json();\r",
							"\r",
							"if (json.accessToken) {\r",
							"    pm.environment.set(\"accessToken\", json.accessToken);\r",
							"}\r",
							"\r",
							"if (json.refreshToken) {\r",
							"    pm.environment.set(\"refreshToken\", json.refreshToken);\r",
							"}"
