{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "IsRunOnAspire": true,
  "ConnectionStrings": {
    "DefaultConnection": "Host=<host>;Port=<port>;Database=<YourDataBase>;Username=<username>;Password=<superSecretPassword>;",
    "redis": "<ConnectionString>"
  },
  "ApiCredentials": {
    "Username": "<Username>",
    "Password": "<Password>"
  },
  "Jwt": {
    "Issuer": "<Issuer>",
    "Audience": "<Audience>",
    "Key": "<superLongSecretKey>",
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeHours": 6
  }
}
