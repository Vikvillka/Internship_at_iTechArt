{

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "RabbitMq": {
    "Queues": {
      "DeleteEntityQueue": "OnMyEntityDeleted"
    },
    "DeleteEntityExchange": "DeleteEntity"
  },
  "ConnectionStrings": {
    "messaging": "amqp://user:password@localhost:5672",
    "DefaultConnection": "Host=localhost;Port=5435;Database=UserService;Username=postgres;Password=password;",
    "redis": "localhost:6379"
  }
}
