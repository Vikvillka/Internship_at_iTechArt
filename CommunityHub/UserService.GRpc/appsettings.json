{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "AllowedHosts": "*",
  "IsRunOnAspire": true,
  "ConnectionStrings": {
    "messaging": "amqp://user:password@localhost:5672",
    "DefaultConnection": "Host=localhost;Port=5435;Database=UserService;Username=postgres;Password=password;",
    "redis": "localhost:6379"
  },
  "RabbitMq": {
    "Queues": {
      "DeleteEntityQueue": "OnMyEntityDeleted"
    },
    "DeleteEntityExchange": "DeleteEntity"
  },
  "ApiCredentials": {
    "Username": "gateway",
    "Password": "Secret123$"
  },
  "Jwt": {
    "Issuer": "CommunityHub",
    "Audience": "CommunityHubUsers",
    "Key": "<superLongSecretKey>",
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeHours": 6
  }
}
